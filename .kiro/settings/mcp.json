{
	"mcpServers": {
		"db-ux": {
			"command": "npx",
			"args": ["--yes", "@db-ux/mcp-server"],
			"disabled": false,
			"autoApprove": ["plan_migration", "scan_generation_2_migration"]
		},
		"chrome-devtools": {
			"command": "npx",
			"args": [
				"--yes",
				"chrome-devtools-mcp@1.13.0",
				"--isolated",
				"--no-usage-statistics",
				"--no-performance-crux"
			],
			"disabled": false,
			"autoApprove": ["list_pages", "new_page", "navigate_page", "take_snapshot", "take_screenshot"]
		}
	}
}
